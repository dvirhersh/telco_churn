"""
<PROJECT_NAME>: uses templates/<TEMPLATE_NAME>.
Project provides Parameters and FitnessClass; template provides DataLoader, ClsPipeline, FitnessCalculationResult.
"""
import sys
from pathlib import Path
from typing import Any

_repo_root = Path(__file__).resolve().parent.parent.parent
_template_dir = _repo_root / "templates" / "<TEMPLATE_NAME>"
if str(_repo_root) not in sys.path:
    sys.path.insert(0, str(_repo_root))
import importlib.util
_spec = importlib.util.spec_from_file_location(
    "<TEMPLATE_MODULE_NAME>",
    _template_dir / "__init__.py",
    submodule_search_locations=[str(_template_dir)],
)
_r2 = importlib.util.module_from_spec(_spec)
sys.modules["<TEMPLATE_MODULE_NAME>"] = _r2
_spec.loader.exec_module(_r2)
FitnessCalculationResult = _r2.FitnessCalculationResult
ClsPipeline = _r2.ClsPipeline
DataLoader = _r2.DataLoader

try:
    from parameters import Parameters
except ModuleNotFoundError:
    _params_spec = importlib.util.spec_from_file_location(
        "project_parameters",
        Path(__file__).resolve().parent / "parameters.py",
    )
    _params_mod = importlib.util.module_from_spec(_params_spec)
    _params_spec.loader.exec_module(_params_mod)
    Parameters = _params_mod.Parameters


class FitnessClass:
    """Earth GA entry point. Loads data via template DataLoader; delegates to ClsPipeline.get_fitness_score."""

    def __init__(self, dataset_root: str):
        self.dataset_root = dataset_root
        self.params = Parameters()
        data_loader = DataLoader(dataset_root, self.params)
        self.data = data_loader.prepare_and_split()

    def calculate_fitness(self, chromosome: Any) -> FitnessCalculationResult:
        try:
            cls_pipeline = ClsPipeline(
                chromosome,
                self.params,
                self.data["X_train"],
                self.data["y_train"],
            )
            score, fitness_composition, info_row = cls_pipeline.get_fitness_score(
                self.data["X_train"],
                self.data["X_test"],
                self.data["y_train"],
                self.data["y_test"],
                self.params,
                revenue_train=self.data.get("revenue_train"),
                revenue_test=self.data.get("revenue_test"),
            )
        except Exception as e:
            raise RuntimeError(
                f"Failed to calculate fitness for chromosome: {type(e).__name__}: {e}\n"
                f"Chromosome keys: {list(chromosome.keys()) if chromosome else 'None'}\n"
                f"Dataset sizes - Train: {len(self.data['X_train'])}, Test: {len(self.data['X_test'])}"
            ) from e
        return FitnessCalculationResult(
            score=score,
            scalars=fitness_composition,
            rows=info_row,
        )
